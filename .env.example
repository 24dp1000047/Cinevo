# ================================
# CINEVO ENVIRONMENT CONFIGURATION
# ================================

# --- Backend Config ---
PORT=5000
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-cinevo-2026-production

# --- Database Config ---
# For instant zero-config local dev (SQLite):
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Supabase, Neon, Railway, Docker):
# DATABASE_URL="postgresql://user:password@localhost:5432/cinevo?schema=public"

# --- Redis Config (Optional - automatically falls back to in-memory TTL cache if empty/unreachable) ---
REDIS_URL=redis://localhost:6379

# --- TMDB Config (Optional - automatically falls back to rich built-in demo catalog if empty) ---
TMDB_API_KEY=

# --- Test Streaming API Config (Optional - built-in authorized open-source HLS test streams included) ---
TEST_STREAM_API_URL=
TEST_STREAM_API_KEY=

# --- Frontend Config ---
NEXT_PUBLIC_API_URL=http://localhost:5000
