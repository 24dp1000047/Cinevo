{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinevo",
  "main": "frontend/.open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "frontend/.open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build"
  }
}
