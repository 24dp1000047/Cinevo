generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  name         String?
  avatar       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  watchlist    Watchlist[]
  history      WatchHistory[]
  preference   UserPreference?
}

model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId      Int
  mediaType   String
  title       String
  posterPath  String?
  voteAverage Float?
  createdAt   DateTime @default(now())

  @@unique([userId, tmdbId, mediaType])
}

model WatchHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tmdbId     Int
  mediaType  String
  title      String
  posterPath String?
  season     Int?
  episode    Int?
  progress   Float
  duration   Float
  updatedAt  DateTime @updatedAt

  @@unique([userId, tmdbId, mediaType, season, episode])
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language        String   @default("en")
  autoplay        Boolean  @default(true)
  defaultQuality  String   @default("1080p")
  enableSubtitles Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}
